# Supabase project settings: Project Settings > API (or "Connect" in the dashboard).
# Without these the site runs on built-in content and admin sign-in is disabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Older projects can use the legacy anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Enquiry notification emails (https://resend.com). Without a key, enquiries are saved but no email is sent.
RESEND_API_KEY=re_xxx
# Optional overrides. FROM must use a domain verified in Resend.
# CONTACT_NOTIFY_TO=sales@feedsport.co.zw
# CONTACT_NOTIFY_FROM=FeedSport website <website@feedsport.co.zw>

# Advisor MCP endpoint (/api/mcp/advisor): every user's saved formulations for
# FeedSport's nutritionist, who signs in with OAuth (see README). The secret
# key bypasses row-level security, so never expose it to the browser.
# SUPABASE_SECRET_KEY=sb_secret_xxx
# Optional static bearer token for scripts / clients without OAuth (32+ characters: openssl rand -hex 32).
# FEEDSPORT_MCP_ADVISOR_TOKEN=
